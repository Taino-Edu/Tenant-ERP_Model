{
  // =============================================================================
  // appsettings.json — Configurações de desenvolvimento
  // ATENÇÃO: Nunca commitar dados sensíveis (senhas, chaves) neste arquivo.
  // Use Secrets Manager (dotnet user-secrets) ou variáveis de ambiente em produção.
  // =============================================================================

  "ConnectionStrings": {
    // PostgreSQL — único banco suportado. OBRIGATÓRIO: a aplicação não sobe sem
    // isso (o multi-tenant é schema/search_path, que só o Postgres tem).
    // Em produção, configure via variável de ambiente: ConnectionStrings__PostgreSQL=...
    // Em dev, suba o Postgres da suíte: docker compose -f tests/docker-compose.yml up -d
    "PostgreSQL": ""
  },

  "JwtSettings": {
    // ATENÇÃO: Substitua por uma chave forte em produção (mínimo 32 caracteres aleatórios)
    "SecretKey": "SUBSTITUA_ESTA_CHAVE_POR_UMA_STRING_SECRETA_E_FORTE_EM_PRODUCAO",
    "Issuer": "https://localhost:5001",
    "Audience": "CardGameStore-Frontend",
    "AccessTokenExpirationMinutes": 480,
    "IntegrationTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 90
  },

  // ---------------------------------------------------------------------------
  // SMTP — conta global da plataforma (fallback). Cada tenant pode configurar a
  // própria conta em Admin > E-mail, que tem prioridade sobre esta.
  // Estes são EXATAMENTE os nomes lidos por EmailService.ResolveSmtpSettingsAsync;
  // antes daqui existia um bloco "EmailSettings" com outros nomes (Host/User/From)
  // que NENHUM código lia — quem preenchia seguindo a doc não enviava e-mail
  // nenhum e não via erro. Se mudar aqui, mude lá.
  // Deixe Host vazio para desabilitar e-mail (funciona sem e-mail em dev/testes).
  // Gmail:  Host=smtp.gmail.com,    Port=587, Username=seu@gmail.com, Password=senha-de-app
  // Resend: Host=smtp.resend.com,   Port=587, Username=resend,        Password=re_xxxxx
  // Em produção: SmtpSettings__Host, SmtpSettings__Password, etc.
  // ---------------------------------------------------------------------------
  "SmtpSettings": {
    "Host": "",
    "Port": 587,
    "Username": "",
    "Password": "",
    "FromEmail": "noreply@tenant-erp.local",
    "FromName": "",
    // Base dos links montados dentro dos e-mails (reset de senha, aviso de
    // reestoque, relatório LGPD). Sem isso os links saem apontando pro
    // placeholder https://tenant-erp.local e não abrem em lugar nenhum.
    "AppUrl": "http://localhost:3000"
  },

  // ---------------------------------------------------------------------------
  // WEB PUSH (VAPID) — notificação de navegador. Sem estas duas chaves o
  // PushService vira no-op silencioso e GET /api/push/vapid-public-key devolve
  // 404 (o front então nem oferece o botão de ativar).
  // Gerar o par: dotnet run --project CardGameStore -- gen-vapid
  // Em produção: Vapid__PublicKey / Vapid__PrivateKey / Vapid__Subject
  // ---------------------------------------------------------------------------
  "Vapid": {
    "PublicKey": "",
    "PrivateKey": "",
    "Subject": "mailto:contato@tenant-erp.local"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    },
    // IncludeScopes liga a saída dos escopos de log. Sem isso o
    // TenantResolutionMiddleware.SetTenantAndContinue abre o escopo com
    // TenantSchema/TenantId e o .NET descarta silenciosamente — o padrão do
    // console provider é ignorar escopo. Com true, toda linha sai sufixada com
    // "=> TenantSchema:loja_x, TenantId:...", então `docker compose logs api |
    // grep loja_x` isola tudo de uma loja só.
    "Console": {
      "IncludeScopes": true
    }
  },

  "AllowedHosts": "*",

  "CorsSettings": {
    "AllowedOrigins": "http://localhost:3000,http://localhost:5173,http://localhost:5000"
  },

  "Security": {
    // Salt para hash SHA-256 de IPs (audit log / consentimentos).
    // Em produção, sobrescreva via variável de ambiente: Security__IpHashSalt=<valor aleatório forte>
    // Gerar: openssl rand -base64 32
    "IpHashSalt": "tenant-erp-dev-salt-TROQUE-EM-PRODUCAO"
  },

  "GeminiSettings": {
    // Chave da API do Google Gemini (opcional — chat IA no painel admin)
    // Obtenha em: https://aistudio.google.com/apikey
    // Em produção, sobrescreva via variável de ambiente: GeminiSettings__ApiKey=<chave>
    "ApiKey": ""
  },

  "Database": {
    "TenantMaxPoolSize": 5,
    "CatalogMaxPoolSize": 15,
    "ConnectionIdleLifetimeSeconds": 60
  },

  // Cobrança da mensalidade DA PLATAFORMA contra as lojas (RB-01).
  // Não confundir com o recebimento das vendas do lojista, que é por tenant e
  // vive em IntegrationConfig (Inter / Mercado Pago) no schema da loja.
  //
  // Vazio = modo manual: a plataforma sobe, não emite cobrança automática, mas a
  // régua de suspensão por vencimento continua rodando.
  //
  // NUNCA cole a chave aqui: este arquivo é versionado, e o
  // appsettings.Development.json também (o .gitignore abre exceção pra ele).
  //
  // Desenvolvimento — user secrets, fora do repositório:
  //   dotnet user-secrets set "Billing:Asaas:ApiKey" "<chave>" --project CardGameStore
  //   dotnet user-secrets set "Billing:Asaas:WebhookToken" "<segredo>" --project CardGameStore
  //
  // Produção — variável de ambiente (duplo underscore):
  //   Billing__Asaas__ApiKey=<chave>
  //   Billing__Asaas__WebhookToken=<segredo>
  //   Billing__Asaas__BaseUrl=https://api.asaas.com/v3/
  "Billing": {
    // Dias de tolerância após o vencimento antes de suspender a loja. Pix cai no
    // mesmo dia, mas boleto compensa em dois dias úteis e feriado estica isso.
    "DiasDeCarenciaAposVencimento": 7,

    "Asaas": {
      // Chave de API da NOSSA conta Asaas (Configurações > Integrações).
      // A do sandbox é diferente da de produção — cada ambiente tem a sua.
      "ApiKey": "",

      // Segredo que NÓS inventamos e cadastramos junto do webhook no painel do
      // Asaas. Ele volta no header asaas-access-token a cada notificação, e é a
      // única coisa que separa uma baixa legítima de um POST de qualquer um.
      // Gerar: openssl rand -base64 32
      "WebhookToken": "",

      // Sandbox por padrão. Apontar pra produção tem que ser ato deliberado —
      // cobrança emitida em produção é cobrança real, contra CNPJ real.
      "BaseUrl": "https://api-sandbox.asaas.com/v3/",

      // PIX, BOLETO, CREDIT_CARD ou UNDEFINED (o lojista escolhe na fatura).
      // PIX é o recomendado: tarifa fixa de R$ 1,99. Em UNDEFINED o lojista pode
      // escolher cartão, e aí a assinatura custa 2,99% + 1,99% sobre o total.
      "BillingType": "PIX"
    }
  },

  "IbptSettings": {
    // Credencial única da plataforma. A tabela resultante fica no catálogo
    // global e é reutilizada por todas as lojas; tenants nunca informam token.
    // Produção: IbptSettings__ApiKey e IbptSettings__Cnpj.
    "ApiKey": "",
    "Cnpj": ""
  },

  // Prospecção de leads (painel da plataforma) — busca via OpenStreetMap
  // (gratuito, sem chave). Só a IA de enriquecimento usa chave, DEDICADA e
  // separada da usada pelo Assistente de IA de cada loja (GeminiSettings
  // acima), pra isolar custo/cota de uma feature da outra.
  "ProspectingSettings": {
    // Chave do Gemini só pra enriquecimento de prospecção (não é a mesma do GeminiSettings acima).
    // Em produção: ProspectingSettings__GeminiApiKey=<chave>
    "GeminiApiKey": ""
  },

  // ---------------------------------------------------------------------------
  // CRIPTOGRAFIA — AES-256-GCM para tokens OAuth e secrets em repouso
  // Gerar chave: dotnet run --project CardGameStore -- gen-key
  // Em produção, usar variável de ambiente: Encryption__Key=<base64>
  // NUNCA commitar a chave real neste arquivo.
  // ---------------------------------------------------------------------------
  "Encryption": {
    "Key": ""
  }

  // Os blocos "Sefaz" e "Inter" que existiam aqui foram removidos: nenhum código
  // os lia. Tanto o certificado A1 da SEFAZ quanto o par .crt/.key do Inter são
  // enviados pelo painel (Admin > Fiscal e Admin > Integrações) e guardados
  // criptografados no banco, por tenant — arquivo em disco compartilhado entre
  // tenants era justamente o bug que essa mudança corrigiu.
}
