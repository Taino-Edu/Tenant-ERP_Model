<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CardGameStore</RootNamespace>
    <AssemblyName>CardGameStore</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Segredos de desenvolvimento (chave do Asaas, tokens de webhook) ficam
         FORA do repositório, no perfil do usuário. Necessário porque o
         .gitignore versiona tanto appsettings.json quanto
         appsettings.Development.json — colar chave em qualquer um dos dois a
         manda pro Git. Uso: dotnet user-secrets set "Chave" "valor" -->
    <UserSecretsId>tenant-erp-model-dev</UserSecretsId>
    <!-- CS1591: "tipo/membro público sem comentário XML" — não queremos exigir
         doc em TUDO (DTOs internos, etc.), só aproveitar os comentários que
         já existem/forem adicionados nos controllers pro Swagger. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CardGameStore.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- XML-002: os XSDs oficiais da SEFAZ precisam existir ao lado do binário no
         contêiner — sem isso o NfceSchemaValidator degrada para "sem validação"
         em produção, silenciosamente, e a barreira antes da transmissão some. -->
    <Content Include="Schemas\**\*.xsd">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- Entity Framework Core -->
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.4.1" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.10" />

    <!-- Authentication / JWT -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.10" />

    <!-- Swagger -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.8.1" />

    <!-- BCrypt -->
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />

    <!-- SignalR (built into ASP.NET Core, but included for clarity) -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="8.0.10" />

    <!-- Health Checks -->
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="8.0.10" />
    <PackageReference Include="AspNetCore.HealthChecks.UI.Client" Version="8.0.1" />

    <!-- QR Code generation -->
    <PackageReference Include="QRCoder" Version="1.4.3" />

    <!-- Parsing de User-Agent para o audit log (SO/navegador/mobile) -->
    <PackageReference Include="UAParser" Version="3.1.47" />

    <!-- Web Push / VAPID — notificações browser push -->
    <PackageReference Include="WebPush" Version="1.0.13" />
    <PackageReference Include="Zeus.Net.NFe.NFCe" Version="2026.6.30.1332" />

    <!-- BouncyCastle: leitura de PKCS#12 com algoritmos legados (RC2/3DES), comuns
         em certificados A1 ICP-Brasil mais antigos. O X509Certificate2 nativo do
         .NET no Linux delega ao OpenSSL do sistema, que desde a versão 3 desativa
         esses algoritmos por padrão — BouncyCastle implementa a decodificação em
         C# puro, sem depender de config nenhuma do SO.
         WebPush 1.0.13 passou a oferecer alvo net8.0 sem Newtonsoft/System.*
         vulneráveis e requer 1.9.0. A referência direta mantém um único assembly
         para WebPush e Zeus.Net.NFe.NFCe. -->
    <PackageReference Include="Portable.BouncyCastle" Version="1.9.0" />
  </ItemGroup>

</Project>
