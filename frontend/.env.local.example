# Copie este arquivo para .env.local e ajuste para desenvolvimento local
NEXT_PUBLIC_API_URL=http://localhost:5000

# Aquisição e mensuração (opcionais). As tags só carregam após consentimento.
# Use o GTM como ponto único para configurar GA4 e conversões do Google Ads.
#
# Deixe VAZIO no dia a dia. lib/marketing.ts trata localhost como página
# comercial de propósito (é o que permite testar o banner de consentimento),
# então preencher com o contêiner de produção manda pageview e lead_submit de
# desenvolvimento para o mesmo GA4 que mede campanha paga. Preencha só quando o
# objetivo for exatamente validar tag no Tag Assistant — e limpe depois.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Token da opção "tag HTML" do Search Console. Para propriedade de domínio,
# prefira o TXT no DNS e deixe este campo vazio.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
